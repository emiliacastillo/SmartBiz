generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MemberRole {
  OWNER
  MANAGER
  VIEWER
}

enum LinkType {
  MENU
  REVIEWS
  INSTAGRAM
  FACEBOOK
  RESERVATION
  BOOKING
  WEBSITE
  WHATSAPP
  PHONE
  CUSTOM
}

enum EventType {
  PAGE_VIEW
  LINK_CLICK
  PROMOTION_CLICK
}

enum SourceType {
  NFC
  QR
  UNKNOWN
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships BusinessMembership[]
}

model Business {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  description    String?
  logoUrl        String?
  primaryColor   String?  @default("#0f172a")
  secondaryColor String?  @default("#f97316")
  phone          String?
  address        String?
  website        String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  memberships BusinessMembership[]
  tags        SmartTag[]
  links       BusinessLink[]
  promotions  Promotion[]
  interactions Interaction[]
}

model BusinessMembership {
  id         String     @id @default(cuid())
  userId     String
  businessId String
  role       MemberRole @default(VIEWER)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([businessId])
  @@index([userId])
}

model SmartTag {
  id        String   @id @default(cuid())
  businessId String
  code      String   @unique
  name      String?
  location  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  interactions Interaction[]

  @@index([businessId])
  @@index([code])
}

model BusinessLink {
  id        String   @id @default(cuid())
  businessId String
  type      LinkType
  label     String
  url       String
  icon      String?
  position  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  interactions Interaction[]

  @@index([businessId, position])
}

model Promotion {
  id             String    @id @default(cuid())
  businessId     String
  title          String
  description    String?
  imageUrl       String?
  destinationUrl String?
  active         Boolean   @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, active])
}

model Interaction {
  id            String      @id @default(cuid())
  businessId    String
  smartTagId    String?
  businessLinkId String?
  eventType     EventType
  source        SourceType  @default(UNKNOWN)
  createdAt     DateTime    @default(now())

  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  smartTag    SmartTag?    @relation(fields: [smartTagId], references: [id], onDelete: SetNull)
  businessLink BusinessLink? @relation(fields: [businessLinkId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([smartTagId])
  @@index([businessLinkId])
}
