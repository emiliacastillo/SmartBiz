generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MemberRole {
  OWNER
  MANAGER
  VIEWER
}

enum LinkType {
  MENU
  REVIEWS
  INSTAGRAM
  FACEBOOK
  RESERVATION
  BOOKING
  WEBSITE
  WHATSAPP
  PHONE
  CUSTOM
}

enum EventType {
  PAGE_VIEW
  LINK_CLICK
  PROMOTION_CLICK
  SERVICE_VIEW
  IMAGE_VIEW
  IMAGE_EXPAND
}

enum SourceType {
  NFC
  QR
  UNKNOWN
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships BusinessMembership[]
}

model Business {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  description    String?
  logoUrl        String?
  primaryColor   String?  @default("#0f172a")
  secondaryColor String?  @default("#f97316")
  phone          String?
  address        String?
  website        String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  memberships BusinessMembership[]
  tags        SmartTag[]
  links       BusinessLink[]
  promotions  Promotion[]
  interactions Interaction[]
  media UploadedImage[]
  contacts CustomerContact[]
}

model UploadedImage {
  id String @id @default(cuid())
  businessId String
  content Bytes
  contentType String
  createdAt DateTime @default(now())
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  @@index([businessId])
}

model BusinessMembership {
  id         String     @id @default(cuid())
  userId     String
  businessId String
  role       MemberRole @default(VIEWER)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([businessId])
  @@index([userId])
}

model SmartTag {
  id        String   @id @default(cuid())
  businessId String
  code      String   @unique
  name      String?
  location  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  linkAssignments SmartTagLink[]
  interactions Interaction[]

  @@index([businessId])
  @@index([code])
}

model BusinessLink {
  id        String   @id @default(cuid())
  businessId String
  type      LinkType
  label     String
  url       String
  description String @default("")
  images    Json @default("[]")
  actions   Json @default("[]")
  icon      String?
  position  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tagAssignments SmartTagLink[]
  interactions Interaction[]

  @@index([businessId, position])
}

model SmartTagLink {
  smartTagId     String
  businessLinkId String
  createdAt      DateTime @default(now())

  smartTag     SmartTag     @relation(fields: [smartTagId], references: [id], onDelete: Cascade)
  businessLink BusinessLink @relation(fields: [businessLinkId], references: [id], onDelete: Cascade)

  @@id([smartTagId, businessLinkId])
  @@index([businessLinkId])
}

model Promotion {
  id             String    @id @default(cuid())
  businessId     String
  title          String
  description    String?
  imageUrl       String?
  destinationUrl String?
  active         Boolean   @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  kind           String    @default("PROMOTION")
  terms          String    @default("")
  entryEnabled   Boolean   @default(false)
  awardMode      String    @default("MANUAL")
  winnerLimit    Int       @default(1)
  entryLimit     Int       @default(1000)
  serviceIds     String[]  @default([])
  redemptionEndsAt DateTime?
  archivedAt     DateTime?
  entries        RewardEntry[]

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, active])
}

model CustomerContact {
  id String @id @default(cuid())
  businessId String
  name String
  email String
  phone String
  emailMarketingConsent Boolean @default(false)
  smsMarketingConsent Boolean @default(false)
  consentUpdatedAt DateTime @default(now())
  createdAt DateTime @default(now())
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  entries RewardEntry[]
  @@unique([businessId, email])
}

model RewardEntry {
  id String @id @default(cuid())
  promotionId String
  contactId String
  publicToken String @unique
  status String @default("PENDING")
  redemptionCode String @unique
  termsSnapshot String
  serviceIds String[]
  emailNoticeConsent Boolean @default(false)
  smsNoticeConsent Boolean @default(false)
  consentVersion String @default("rewards-v1")
  emailNoticeState String @default("PENDING")
  smsNoticeState String @default("PENDING")
  createdAt DateTime @default(now())
  awardedAt DateTime?
  redeemedAt DateTime?
  redeemedServiceId String?
  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  contact CustomerContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  @@unique([promotionId, contactId])
  @@index([promotionId, status])
}

model Interaction {
  id            String      @id @default(cuid())
  businessId    String
  smartTagId    String?
  businessLinkId String?
  eventType     EventType
  source        SourceType  @default(UNKNOWN)
  informationType String?
  targetId      String?
  createdAt     DateTime    @default(now())

  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  smartTag    SmartTag?    @relation(fields: [smartTagId], references: [id], onDelete: SetNull)
  businessLink BusinessLink? @relation(fields: [businessLinkId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([smartTagId])
  @@index([businessLinkId])
  @@index([businessId, businessLinkId, createdAt])
}
